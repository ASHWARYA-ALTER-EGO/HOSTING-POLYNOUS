# REQUIRED - System API Keys (fallback)
ANTHROPIC_API_KEY=your-anthropic-key
TAVILY_API_KEY=your-tavily-key
VOYAGE_API_KEY=your-voyage-key

# OPTIONAL - User can provide their own
OPENAI_API_KEY=your-openai-key

# Database (PostgreSQL for production)
DATABASE_URL=postgresql://user:password@host:5432/polynous

# Neo4j Knowledge Graph
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# Pinecone Vector DB
PINECONE_API_KEY=your-pinecone-key
PINECONE_ENVIRONMENT=gcp-starter

# JWT Secret - CHANGE THIS in production!
JWT_SECRET=generate-a-random-string-here
ENCRYPTION_KEY=generate-another-random-string

# OAuth (optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-secret

# Frontend URL (for CORS + OAuth redirects)
FRONTEND_URL=http://localhost:5174